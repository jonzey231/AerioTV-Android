<?xml version="1.0" encoding="utf-8"?>
<!-- Multiview tile on a TextureView: the comparison path kept behind
     debug.aerio.tile_view=texture. Default tiles use
     multiview_tile_player_surface.xml (SurfaceView), measured 2026-09-02 as
     the only path that reaches 60fps 4-up on the Google TV Streamer. -->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view" />
