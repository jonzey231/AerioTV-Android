<?xml version="1.0" encoding="utf-8"?>
<!-- Multiview tile video surface. Exists only to set surface_type, which
     PlayerView reads at constructor time and cannot change later.

     SurfaceView, MEASURED (Streamer field session 2026-08-31): the June
     texture_view choice (critique round 3) routed every decoded frame of
     every tile through the app's RenderThread - gfxinfo showed the UI
     drawing a continuous 60fps with two tiles at rest, with matching
     coroutine-dispatcher, GC, and sys-time churn, and visible playback
     stutter that does not exist on the tvOS build (whose tiles ride the
     system compositor). SurfaceView returns tiles to SurfaceFlinger:
     planes beyond the HWC overlay budget fall back to SF's own GPU
     composition, which is still one copy cheaper than TextureView. If
     large grids ever tear again, choose the layout per tile count
     instead of reverting wholesale. -->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="surface_view" />
