<?xml version="1.0" encoding="utf-8"?>
<!-- Multiview tile on a SurfaceView (experiment 2026-09-02): the display
     hardware composes the decoder's buffer directly, skipping the per-frame
     MDP-to-texture conversion that held the TextureView grid at 30fps on the
     Google TV Streamer. Selected at runtime via debug.aerio.tile_view. -->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="surface_view" />
